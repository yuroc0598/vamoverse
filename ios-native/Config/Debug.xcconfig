// Debug: com.vamoverse.app.dev against the local dev server, dev sign-in (/api/auth/dev).
// Override the server at launch: `-VamoBaseURL http://192.168.1.20:3000` (launch argument).
#include "Shared.xcconfig"
VAMO_BUNDLE_SUFFIX = .dev
VAMO_DISPLAY_NAME = Vamoverse Dev
// "//" starts a comment in xcconfig files; $() splits it.
VAMO_BASE_URL = http:/$()/localhost:3000
VAMO_INFOPLIST = Config/Info-Debug.plist
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG $(inherited)
SWIFT_OPTIMIZATION_LEVEL = -Onone
DEBUG_INFORMATION_FORMAT = dwarf
ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES
// Debug signs in with the dev route; no entitlements (push needs an APNs-enabled team: [USER]).
VAMO_ENTITLEMENTS =
VAMO_SUPABASE_URL =
VAMO_SUPABASE_ANON_KEY =
