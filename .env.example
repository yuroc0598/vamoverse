# ---------------------------------------------------------------------------
# Vamoverse environment
#
# Set this only for local development. Production always rejects demo mode.
NEXT_PUBLIC_DEMO_MODE=true

# Leave DATABASE_URL and REDIS_URL empty for the zero-infra local demo:
#   - data comes from src/lib/domain/catalog.ts
#   - registration / rate-limit / webhook-dedup use in-memory stores
#
# Set them (e.g. via `docker compose up -d`) to switch to the REAL backend:
#   - registration becomes atomic (Postgres FOR UPDATE, no overbooking)
#   - payment idempotency + webhook dedup + rate limits become durable/shared
# ---------------------------------------------------------------------------

# Supabase (auth). These placeholders are used only because demo mode is
# explicitly enabled above; URL contents never select demo mode in production.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.mock
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key

# Real data layer (optional). When set, the app uses Postgres + Redis.
# docker compose defaults:
# DATABASE_URL=postgres://vamoverse:vamoverse@localhost:5432/vamoverse
# REDIS_URL=redis://localhost:6379
DATABASE_URL=
REDIS_URL=

# Third-party
NEXT_PUBLIC_GOOGLE_PLACES_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=

# Optional override for the UTR public player search used by the UTR account check
# UTR_SEARCH_URL=https://api.utrsports.net/v2/search/players

# Secrets for server-authenticated endpoints
CRON_SECRET=
VAMOS_HMAC_SECRET=

# Behavior
AUTO_CAPTURE_DELAY_MINUTES=2
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=

# Native release shell (must be HTTPS in production)
CAPACITOR_SERVER_URL=https://vamoverse.app

# Optional database tuning
PG_POOL_MAX=10
PGSSL=
