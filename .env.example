# ---------------------------------------------------------------------------
# Vamoverse configuration
#
# Local development needs only DATABASE_URL. Run `npm run db:dev` (no Docker)
# or `docker compose up -d`. Everything else falls back to local stand-ins:
#   auth      → signed dev sessions (sign in with any email, nothing is sent)
#   payments  → simulated checkout pages that run the real confirmation logic
#   email/SMS → written to the server log
# Production refuses to start unless every "required in production" value is set.
# ---------------------------------------------------------------------------

# Database (required). npm run db:dev serves PGlite on 5433; docker compose on 5432.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres
# PGSSL=require        # verify the server certificate (set PGSSL_CA if not publicly trusted)
PG_POOL_MAX=1          # PGlite (npm run db:dev) serves one connection; use 5+ on real Postgres

# Public URL of the app (required in production)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth (required in production): email links, SMS codes, Google, Apple
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Connect + Billing (required in production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Email via Resend (required in production)
RESEND_API_KEY=
EMAIL_FROM="Vamoverse <hello@vamoverse.app>"

# SMS via Twilio (optional; texts are skipped without it)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Assistant (optional; the assistant is hidden without it)
ANTHROPIC_API_KEY=

# Signs booking-management links in emails/texts (required in production; any long random string)
LINK_SECRET=

# Scheduled jobs call /api/cron/* with "Authorization: Bearer $CRON_SECRET" (required in production)
CRON_SECRET=

# Native shell (must be HTTPS in production)
CAPACITOR_SERVER_URL=https://vamoverse.app
# The Capacitor wrapper (ios/) is retired in favour of the native app (ios-native/) and its
# commands are off by default. Set to false to use them anyway (read by the npm scripts).
IOS_WRAPPER_DISABLED=true
