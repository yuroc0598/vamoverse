{
  "name": "vamoverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit --pretty false",
    "lint": "eslint . --max-warnings=0",
    "seed": "tsx src/lib/seed.ts",
    "db:migrate": "for file in db/migrations/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$file\"; done",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/seed.sql",
    "verify:infra": "tsx scripts/verify-infra.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "test:smoke": "vitest run tests/smoke",
    "test:coverage": "vitest run --coverage",
    "ios:init": "cap init Vamoverse com.vamoverse.app --web-dir=mobile-shell",
    "ios:add": "cap add ios",
    "ios:build": "next build",
    "ios:sync": "npm run ios:build && NODE_ENV=production CAPACITOR_SERVER_URL=${CAPACITOR_SERVER_URL:-https://vamoverse.app} cap sync ios",
    "ios:open": "cap open ios",
    "ios:dev": "bash scripts/ios.sh go",
    "ios:livereload": "cap run ios --external --livereload --host=0.0.0.0 --port=3000",
    "ios:run": "bash scripts/ios.sh run",
    "ios:go": "bash scripts/ios.sh go",
    "ios:logs": "bash scripts/ios.sh logs",
    "ios:ip": "bash scripts/ios.sh ip",
    "ios:device": "bash scripts/ios.sh device"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@hookform/resolvers": "^3.6.0",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.51.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.400.0",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.52.1",
    "rrule": "^2.8.1",
    "sonner": "^1.5.0",
    "stripe": "^22.3.2",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "8.5.24",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.6",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3",
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.6"
  }
}
