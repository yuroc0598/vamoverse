{
  "name": "vamoverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit --pretty false",
    "lint": "eslint . --max-warnings=0",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ios": "tsx scripts/e2e-ios/run.ts",
    "test:ios-native": "tsx scripts/e2e-ios/run-native.ts",
    "ios:sim": "tsx scripts/ios-sim.ts",
    "ios:sim:native": "tsx scripts/ios-sim-native.ts",
    "ios:fixtures": "tsx scripts/record-fixtures.ts",
    "ios:check-inputs": "tsx scripts/check-native-inputs.ts",
    "ios:push": "tsx scripts/ios-push.ts",
    "ios:wording": "tsx scripts/check-native-wording.ts",
    "api:catalog": "tsx scripts/api-catalog.ts",
    "ios:init": "tsx scripts/ios-wrapper.ts && cd ios-wrapper && cap init Vamoverse com.vamoverse.app --web-dir=mobile-shell",
    "ios:add": "tsx scripts/ios-wrapper.ts && cd ios-wrapper && cap add ios",
    "ios:build": "next build",
    "ios:sync": "tsx scripts/ios-wrapper.ts && npm run ios:build && cd ios-wrapper && NODE_ENV=production CAPACITOR_SERVER_URL=${CAPACITOR_SERVER_URL:-https://vamoverse.app} cap sync ios",
    "ios:open": "tsx scripts/ios-wrapper.ts && cd ios-wrapper && cap open ios",
    "ios:dev": "tsx scripts/ios-wrapper.ts && bash ios-wrapper/ios.sh go",
    "ios:livereload": "tsx scripts/ios-wrapper.ts && cd ios-wrapper && cap run ios --external --livereload --host=0.0.0.0 --port=3000",
    "ios:run": "tsx scripts/ios-wrapper.ts && bash ios-wrapper/ios.sh run",
    "ios:go": "tsx scripts/ios-wrapper.ts && bash ios-wrapper/ios.sh go",
    "ios:logs": "tsx scripts/ios-wrapper.ts && bash ios-wrapper/ios.sh logs",
    "ios:ip": "tsx scripts/ios-wrapper.ts && bash ios-wrapper/ios.sh ip",
    "ios:device": "tsx scripts/ios-wrapper.ts && bash ios-wrapper/ios.sh device",
    "db:dev": "tsx scripts/dev-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^1.5.0",
    "stripe": "^22.3.2",
    "tailwind-merge": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "bplist-creator": "^0.1.1",
    "bplist-parser": "^0.3.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "8.5.24",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.6",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3",
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.6"
  }
}
